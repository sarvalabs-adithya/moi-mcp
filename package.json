{
  "name": "@moi-protocol/mcp-server",
  "version": "0.1.0",
  "description": "MCP server for the MOI network. Agents read chain state and propose transactions; signing happens on your phone via MOI Wallet. The server holds zero private keys.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "moi-mcp": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "examples",
    ".env.example"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect": "npx -y @modelcontextprotocol/inspector tsx src/index.ts",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "moi",
    "blockchain",
    "walletconnect",
    "ai-agents"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@walletconnect/sign-client": "^2.17.0",
    "@walletconnect/utils": "^2.17.0",
    "dotenv": "^16.4.5",
    "js-moi-agent-registry": "^0.3.0-rc1",
    "js-moi-sdk": "^0.8.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
