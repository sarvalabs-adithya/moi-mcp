# Every variable the server reads. Copy to .env (the server loads it from its
# working directory, quietly) or put the same keys in your MCP client's `env`
# block. Blank values fall back to the defaults shown.

# Which MOI network to talk to: voyage | mainnet | custom
MOI_NETWORK=voyage

# JSON-RPC endpoint. Required when MOI_NETWORK=custom; mainnet has no published
# endpoint, so it needs this too.
# MOI_RPC_URL=https://...

# REQUIRED for the stdio server (moi-mcp). WalletConnect project id — this is
# how your laptop and your phone find each other through the relay. It is a
# public identifier, not a secret, but keep it out of git anyway.
#
# Get one free:
#   1. Sign in at https://cloud.reown.com
#   2. Create a project (any name; type "AppKit" is fine)
#   3. Copy the Project ID — 32 hex characters
#
# Reads work without it. Pairing and every write do not. Placeholders such as
# REPLACE_ME are rejected with a message pointing here.
# The read-only HTTP server (moi-mcp-http / node dist/http.js) does not need it
# at all — it satisfies the shared config schema itself, so /health returns
# {"ok":true,…} and every read works with nothing configured.
WC_PROJECT_ID=REPLACE_ME

# Where session.json and the WalletConnect keystore live (created 0700)
MOI_MCP_HOME=~/.moi-mcp

# Explorer base used to build explorerUrl in write results
MOI_EXPLORER_URL=https://voyage.moi.technology

# How long to wait for the phone (ms). Keep it UNDER the MCP client's own
# timeout (60s in the SDK), or a late tap broadcasts an interaction the client
# already reported as timed out.. Default 5 min.
REQUEST_TIMEOUT_MS=55000

# silent | error | info | debug  — all logs go to stderr, never stdout
LOG_LEVEL=error

# Agent registry logic id. Same variable js-moi-agent-registry reads, so both
# can be repointed together. Default: the devnet deployment
# 0x20000000c684f926ed158d0cbfe66af0e482a389393e7899a5a73fcb00000000
# MOI_AGENT_REGISTRY_LOGIC_ID=0x...

# Participant id used as the *caller* for read-only logic simulation
# (moi_call_logic kind:view, moi_resolve_agent). The node resolves the caller's
# account, so a placeholder identity can fail with "account not found". Any
# real participant id on the network works.
# MOI_READ_CALLER=0x...

# WalletConnect payload style for moi.sendInteractions: positional | ix_args.
# The live write path uses moi.signInteraction with params [ixObject] and
# ignores this; it only matters if the wallet's sendInteractions is re-enabled.
# MOI_WC_PARAM_STYLE=positional

# HTTP server only (moi-mcp-http / node dist/http.js): port to listen on
# PORT=8787
