# Which MOI network to talk to: voyage | mainnet | custom
MOI_NETWORK=voyage

# Only required when MOI_NETWORK=custom
# MOI_RPC_URL=https://...

# WalletConnect Cloud project id — https://cloud.reown.com
# TODO(rahul): shared project id to ship as a package default (open question 6)
WC_PROJECT_ID=REPLACE_ME

# Where session.json and the WalletConnect keystore live
MOI_MCP_HOME=~/.moi-mcp

# Explorer base used to build explorerUrl in write results
# TODO: confirm canonical explorer host
MOI_EXPLORER_URL=https://voyage.moi.technology

# How long to wait for the user to approve on their phone (ms)
REQUEST_TIMEOUT_MS=300000

# silent | error | info | debug  — all logs go to stderr, never stdout
LOG_LEVEL=error
